{
  "name": "model-forensics-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "preprocess": "bun run scripts/preprocess.ts",
    "dev": "vite --host 127.0.0.1",
    "check": "vue-tsc -b",
    "build": "bun run preprocess && vue-tsc -b && vite build",
    "test": "bun test",
    "verify:data": "bun run scripts/verify-data.ts",
    "test:browser": "bun run scripts/smoke.ts",
    "deploy": "bun run build && wrangler pages deploy dist --project-name model-forensics-vncntt --branch main",
    "preview": "vite preview --host 127.0.0.1",
    "dev:cloudflare": "wrangler pages dev dist",
    "db:local": "wrangler d1 migrations apply model-forensics-annotations --local",
    "db:remote": "wrangler d1 migrations apply model-forensics-annotations --remote"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/bun": "^1.3.0",
    "@types/markdown-it": "^14.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "cheerio": "^1.1.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "^4.162.0"
  }
}
