              line = add_return_type(line, 'int')\n            elif func_name == 'run' or func_name.endswith('_run'):\n                line = add_return_type(line, 'None')\n            else:\n                # Default for most functions\n                line = add_return_type(line, 'Any')\n        \n        new_lines.append(line)\n        i += 1\n    \n    with open(filepath, 'w') as f:\n        f.writelines(new_lines)\n\nprint(\"Added basic type annotations to remaining functions.\")\nEOF\npython /tmp/fix_types.py"}
