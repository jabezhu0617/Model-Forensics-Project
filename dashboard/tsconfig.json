{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "bun", "@cloudflare/workers-types"],
    "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "scripts/**/*.ts", "functions/**/*.ts", "server/**/*.ts", "vite.config.ts"]
}
